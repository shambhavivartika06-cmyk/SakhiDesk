# SakhiDesk Environment Variables
# Copy this file to .env.local and fill in the values

# Google Gemini API Key (Used for AI order extraction from text/images and AI assistant)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PayPal Sandbox Credentials (Used for Invoicing REST API)
# Create a Sandbox App at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional Groq API Key (Fallback LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
